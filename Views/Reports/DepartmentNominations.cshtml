@model IEnumerable<EOM.Web.Controllers.DepartmentNominationStats>

@{
    ViewData["Title"] = "تقرير ترشيحات الدوائر";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📈 تقرير ترشيحات الدوائر</h1>
        <div>
            <a href="@Url.Action("ExportDepartmentNominations")" class="btn btn-success">
                <i class="fas fa-download me-2"></i>تصدير Excel
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">
                <i class="fas fa-arrow-right me-2"></i>العودة للتقارير
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">إحصائيات الترشيحات حسب الدائرة</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>اسم الدائرة</th>
                                <th class="text-center">إجمالي الترشيحات</th>
                                <th class="text-center">ترشيحات الدورة الحالية</th>
                                <th class="text-center">آخر تاريخ ترشيح</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@dept.DepartmentName</strong>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge">@dept.TotalNominations</span>
                                    </td>
                                    <td class="text-center">
                                        @if (dept.CurrentCycleNominations > 0)
                                        {
                                            <span class="badge bg-success fs-6">@dept.CurrentCycleNominations</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (dept.LastNominationDate.HasValue)
                                        {
                                            <small>@dept.LastNominationDate.Value.ToString("yyyy-MM-dd")</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">لا يوجد</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th>المجموع</th>
                                <th class="text-center">@Model.Sum(d => d.TotalNominations)</th>
                                <th class="text-center">@Model.Sum(d => d.CurrentCycleNominations)</th>
                                <th class="text-center">-</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
 
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            لا توجد بيانات ترشيحات متاحة حالياً.
        </div>
    }
</div>