@{
    ViewData["Title"] = "التقارير";
}

<div class="container">
    <div class="row mb-5">
        <div class="col text-center">
            <div class="mb-4">
                <i class="fas fa-chart-line fa-3x text-primary mb-3 d-block"></i>
                <h2 class="fw-bold">التقارير والإحصائيات</h2>
                <p class="text-muted">اختر التقرير المطلوب من القائمة أدناه</p>
            </div>
        </div>
    </div>
    
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="list-group">
                <a href="@Url.Action("DepartmentNominations")" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 shadow-sm mb-3 rounded">
                    <div class="me-3">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                            <i class="fas fa-building fa-2x text-primary"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="mb-1 fw-bold">تقرير ترشيحات الدوائر</h5>
                        <p class="mb-0 text-muted">
                            <i class="fas fa-chart-pie text-secondary me-1"></i>
                            إحصائيات الترشيحات لكل دائرة في المؤسسة
                        </p>
                    </div>
                    <i class="fas fa-arrow-circle-left text-primary fs-4"></i>
                </a>
                
                <a href="@Url.Action("NominationsWithScores")" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 shadow-sm mb-3 rounded">
                    <div class="me-3">
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                            <i class="fas fa-trophy fa-2x text-warning"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="mb-1 fw-bold">تقرير الترشيحات والدرجات</h5>
                        <p class="mb-0 text-muted">
                            <i class="fas fa-star text-secondary me-1"></i>
                            عرض جميع الترشيحات مع الدرجات والفائزين
                        </p>
                    </div>
                    <i class="fas fa-arrow-circle-left text-warning fs-4"></i>
                </a>
                
                <a href="@Url.Action("Winners")" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 shadow-sm mb-3 rounded">
                    <div class="me-3">
                        <div class="bg-success bg-opacity-10 rounded-circle p-3">
                            <i class="fas fa-medal fa-2x text-success"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="mb-1 fw-bold">تقرير الفائزون</h5>
                        <p class="mb-0 text-muted">
                            <i class="fas fa-crown text-secondary me-1"></i>
                            عرض وتصدير قائمة الفائزين حسب الدورة
                        </p>
                    </div>
                    <i class="fas fa-arrow-circle-left text-success fs-4"></i>
                </a>
            </div>
        </div>
    </div>
</div>