@model IEnumerable<EOM.Web.Models.Evaluation>
@using System.Linq

@{
    ViewData["Title"] = "تقييماتي المكتملة";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Helper function to calculate total weighted score
    double CalculateTotalScore(EOM.Web.Models.Evaluation evaluation)
    {
        if (evaluation.Nomination?.AwardCycle?.AwardType?.Criteria == null || !evaluation.EvaluationScores.Any())
        {
            return 0;
        }

        double totalWeightedScore = 0;

        foreach (var criterion in evaluation.Nomination.AwardCycle.AwardType.Criteria)
        {
            double criterionTotal = 0;
            double criterionMax = 0;

            foreach (var sub in criterion.SubCriteria)
            {
                var score = evaluation.EvaluationScores.FirstOrDefault(s => s.SubCriteriaId == sub.SubCriteriaId);
                criterionTotal += score?.Score ?? 0;
                criterionMax += sub.MaxScore;
            }

            if (criterionMax > 0)
            {
                var normalized = criterionTotal / criterionMax;
                totalWeightedScore += normalized * (double)criterion.WeightPercent;
            }
        }
        return totalWeightedScore;
    }
}

<!-- Page header with action button -->
<div class="page-header glass-fade-in mb-4">
    <h1 class="m-0">تقييماتي المكتملة</h1>
    <a asp-action="Pending" class="btn btn-primary d-flex align-items-center">
        <i class="fas fa-list-check me-2"></i>
        عرض الترشيحات قيد الانتظار
    </a>
</div>

<style>
    /* Enhanced accordion styling */
    .accordion-button {
        font-size: 1.1rem;
        padding: 1rem 1.5rem;
    }
    
    .accordion-button:not(.collapsed) {
        background-color: #f8f9fa;
        color: #495057;
    }
    
    .accordion-button.bg-light {
        font-size: 1rem;
        padding: 0.75rem 1.25rem;
    }
    
    .accordion-button.bg-light:not(.collapsed) {
        background-color: #e9ecef !important;
    }
    
    .accordion-body {
        padding: 0;
    }
    
    /* Avatar circle for employees */
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
    }
    
    /* Nested accordion styling */
    .accordion-flush .accordion-item {
        border: none;
        border-bottom: 1px solid #dee2e6;
    }
    
    .accordion-flush .accordion-item:last-child {
        border-bottom: none;
    }
    
    /* Award type icon colors */
    .fa-award {
        color: #ffc107;
    }
    
    /* Hover effects */
    .accordion-button:hover {
        background-color: #f8f9fa;
    }
    
    /* Table enhancements */
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    
    /* Badge styling */
    .badge {
        font-weight: 500;
        padding: 0.35em 0.65em;
    }
    
    /* Score badge colors */
    .badge-success {
        background-color: #28a745;
    }
    
    .badge-info {
        background-color: #17a2b8;
    }
    
    .badge-warning {
        background-color: #ffc107;
        color: #212529;
    }
    
    .badge-danger {
        background-color: #dc3545;
    }
    
    /* Smooth transitions */
    .accordion-collapse {
        transition: all 0.3s ease;
    }
</style>


@if (!Model.Any())
{
    <div class="alert alert-info">لم تقم بإكمال أي تقييم بعد.</div>
}
else
{
    // Quick stats
    var total = Model.Count();
    var avgScore = Model.Average(e => CalculateTotalScore(e));
    var awardTypesCount = Model.Select(e => e.Nomination?.AwardCycle?.AwardType?.Name).Distinct().Count();
    var departmentsCount = Model.Select(e => new { 
            Name = e.Nomination?.Employee?.Department?.Name ?? "غير محدد",
            Description = e.Nomination?.Employee?.Department?.Description ?? "غير محدد"
        }).Distinct().Count();

    <div class="row mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card text-center glass-fade-in">
                <div class="stat-number">@total</div>
                <div class="stat-label">إجمالي التقييمات</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card text-center glass-fade-in">
                <div class="stat-number">@avgScore.ToString("F1")</div>
                <div class="stat-label">متوسط الدرجة</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card text-center glass-fade-in">
                <div class="stat-number">@awardTypesCount</div>
                <div class="stat-label">أنواع الجوائز</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card text-center glass-fade-in">
                <div class="stat-number">@departmentsCount</div>
                <div class="stat-label">عدد الدوائر</div>
            </div>
        </div>
    </div>

    // Group by Award Type first
    var groupedByAwardType = Model
        .GroupBy(e => new { 
            AwardTypeId = e.Nomination?.AwardCycle?.AwardTypeId ?? 0,
            AwardTypeName = e.Nomination?.AwardCycle?.AwardType?.Name ?? "غير محدد",
            CycleId = e.Nomination?.CycleId ?? 0,
            Month = e.Nomination?.AwardCycle?.Month ?? 0,
            Year = e.Nomination?.AwardCycle?.Year ?? 0
        })
        .OrderBy(g => g.Key.AwardTypeId)
        .ThenByDescending(g => g.Key.Year)
        .ThenByDescending(g => g.Key.Month);

    int accordionIndex = 0;
    foreach (var awardTypeGroup in groupedByAwardType)
    {
        var awardTypeId = $"award-{accordionIndex}";
        var awardTypeCount = awardTypeGroup.Count();
        var isExpanded = accordionIndex == 0; // Expand first award type by default
        
        <div class="accordion mb-4" id="accordion-@awardTypeId">
            <div class="accordion-item glass-fade-in">
                <h2 class="accordion-header" id="heading-@awardTypeId">
                    <button class="accordion-button @(!isExpanded ? "collapsed" : "")" type="button" 
                            data-bs-toggle="collapse" data-bs-target="#collapse-@awardTypeId" 
                            aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="collapse-@awardTypeId">
                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <div>
                                <i class="fas fa-award me-2 text-warning"></i>
                                <strong>@awardTypeGroup.Key.AwardTypeName</strong>
                                <span class="text-muted ms-2">(@awardTypeGroup.Key.Month/@awardTypeGroup.Key.Year)</span>
                            </div>
                            <span class="badge bg-secondary">@awardTypeCount @(awardTypeCount == 1 ? "تقييم" : "تقييمات")</span>
                        </div>
                    </button>
                </h2>
                <div id="collapse-@awardTypeId" class="accordion-collapse collapse @(isExpanded ? "show" : "")" 
                     aria-labelledby="heading-@awardTypeId" data-bs-parent="#accordion-@awardTypeId">
                    <div class="accordion-body p-0">
                        @{
                            // Group by Department within each Award Type
                            var groupedByDept = awardTypeGroup
                                .GroupBy(e => new { 
                                    Name = e.Nomination?.Employee?.Department?.Name ?? "غير محدد",
                                    Description = e.Nomination?.Employee?.Department?.Description ?? "غير محدد"
                                })
                                .OrderBy(g => g.Key.Name)
                                .ThenBy(g => g.Key.Description);

                            int deptIndex = 0;
                            foreach (var dept in groupedByDept)
                            {
                                var deptId = $"{awardTypeId}-dept-{deptIndex}";
                                var displayName = dept.Key.Description;
                                var isDeptExpanded = deptIndex == 0; // Expand first department
                                
                                <div class="accordion accordion-flush" id="accordion-@deptId">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="heading-@deptId">
                                            <button class="accordion-button @(!isDeptExpanded ? "collapsed" : "") bg-light" type="button" 
                                                    data-bs-toggle="collapse" data-bs-target="#collapse-@deptId" 
                                                    aria-expanded="@(isDeptExpanded ? "true" : "false")" aria-controls="collapse-@deptId">
                                                <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                                    <div>
                                                        <i class="fas fa-building me-2 text-secondary"></i>
                                                        @displayName
                                                    </div>
                                                    <span class="badge bg-secondary">@dept.Count() @(dept.Count() == 1 ? "تقييم" : "تقييمات")</span>
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="collapse-@deptId" class="accordion-collapse collapse @(isDeptExpanded ? "show" : "")" 
                                             aria-labelledby="heading-@deptId" data-bs-parent="#accordion-@deptId">
                                            <div class="accordion-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table table-hover align-middle m-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>المرشح</th>
                                                                <th>تاريخ التقييم</th>
                                                                @if (awardTypeGroup.Key.AwardTypeId != 1)
                                                                {
                                                                    <th>عنوان المبادرة</th>
                                                                }
                                                                <th>الدرجة النهائية</th>
                                                                <th style="width: 120px;">الإجراءات</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                        @foreach (var evaluation in dept.OrderByDescending(e => e.CreatedAt))
                                                        {
                                                            var score = CalculateTotalScore(evaluation);
                                                            string badgeClass = score >= 90 ? "badge-success" :
                                                                                score >= 70 ? "badge-info" :
                                                                                score >= 50 ? "badge-warning" : "badge-danger";
                                                            <tr>
                                                                <td>
                                                                    <div class="d-flex align-items-center">
                                                                        <div class="avatar-circle me-2">
                                                                            <i class="fas fa-user"></i>
                                                                        </div>
                                                                        <div>
                                                                            <strong>@evaluation.Nomination?.Employee?.FirstName @evaluation.Nomination?.Employee?.LastName</strong>
                                                                            <br />
                                                                            <small class="text-muted">@evaluation.Nomination?.Employee?.JobTitle</small>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td>@evaluation.CreatedAt.ToString("dd/MM/yyyy")</td>
                                                                @if (awardTypeGroup.Key.AwardTypeId != 1)
                                                                {
                                                                    <td>
                                                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@evaluation.Nomination?.Title">
                                                                            @evaluation.Nomination?.Title
                                                                        </span>
                                                                    </td>
                                                                }
                                                                <td>
                                                                    <span class="badge @badgeClass" style="font-size: 1rem;">
                                                                        @score.ToString("F1")
                                                                    </span>
                                                                </td>
                                                                <td>
                                                                    <a asp-action="Edit" asp-route-id="@evaluation.EvaluationId" 
                                                                       class="btn btn-sm btn-secondary d-flex align-items-center justify-content-center">
                                                                        <i class="fas fa-edit me-1"></i>
                                                                        تعديل
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                deptIndex++;
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        accordionIndex++;
    }
} 