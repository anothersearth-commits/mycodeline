@model IEnumerable<EOM.Web.Models.Nomination>
@using System.Linq
 
 @{ 
     ViewData["Title"] = "الترشيحات للتقييم";
     Layout = "~/Views/Shared/_Layout.cshtml";
 }
<!-- Page header with action button -->
<div class="page-header glass-fade-in mb-4">
    <h1 class="m-0">الترشيحات التي تحتاج إلى تقييم</h1>
    <a asp-action="Index" class="btn btn-primary d-flex align-items-center">
        <i class="fas fa-check-double me-2"></i>
        عرض التقييمات المكتملة
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success">لا توجد ترشيحات بانتظار تقييمك حالياً.</div>
}
else
{
    // Quick stats
    var total = Model.Count();
    var departmentsCount = Model.Select(n => new { 
            Name = n.Employee?.Department?.Name ?? "غير محدد",
            Description = n.Employee?.Department?.Description ?? "غير محدد"
        }).Distinct().Count();

    <div class="row mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card text-center glass-fade-in">
                <div class="stat-number">@total</div>
                <div class="stat-label">إجمالي الترشيحات</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card text-center glass-fade-in">
                <div class="stat-number">@departmentsCount</div>
                <div class="stat-label"> عدد الدائرة</div>
            </div>
        </div>
    </div>

    var grouped = Model
        .GroupBy(n => new { 
            Name = n.Employee?.Department?.Name ?? "غير محدد",
            Description = n.Employee?.Department?.Description ?? "غير محدد"
        })
        .OrderBy(g => g.Key.Name)
        .ThenBy(g => g.Key.Description);

    foreach (var dept in grouped)
    {
        var displayName = dept.Key.Description;
        <div class="card glass-fade-in mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="m-0">@displayName</h5>
                <span class="badge bg-secondary">@dept.Count()</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="table-light">
                            <tr>
                                <th>الموظف</th>
                                <th>نوع الجائزة</th>
                                <th>الدورة</th>
                                <th>تاريخ الترشيح</th>
                                <th style="width: 120px;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var nomination in dept)
                        {
                            <tr>
                                <td>
                                    @nomination.Employee?.FirstName <br />
                                    
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@nomination.AwardCycle?.AwardType?.Name</span>
                                </td>
                                <td>@nomination.AwardCycle?.Month/@nomination.AwardCycle?.Year</td>
                                <td>@nomination.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a class="btn btn-sm btn-success d-flex align-items-center" href="@Url.Action("Create", "Evaluations", new { nominationId = nomination.NominationId })">
                                        <i class="fas fa-pen me-1"></i>
                                        تقييم
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
} 