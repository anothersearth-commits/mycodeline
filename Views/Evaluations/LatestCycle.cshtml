@model EOM.Web.Models.AwardCycle
@{
    ViewData["Title"] = "مراجعة آخر دورة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br>

    <!-- Cycle Info Card -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1">@Model.AwardType?.Name</h4>
                    <small class="opacity-90">@Model.Month/@Model.Year</small>
                </div>
                <div>
                    <span class="badge" style="background-color: rgba(255,255,255,0.2); color: white;">
                        @(Model.Status == EOM.Web.Models.CycleStatus.Pending ? "في الانتظار" : 
                          Model.Status == EOM.Web.Models.CycleStatus.Nomination ? "باب الترشيح مفتوح" :
                          Model.Status == EOM.Web.Models.CycleStatus.Evaluating ? "باب التقييم مفتوح" :
                          Model.Status == EOM.Web.Models.CycleStatus.Closed ? "مغلقة" : "منشورة")
                    </span>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <p class="mb-1"><strong>إجمالي الترشيحات:</strong> @Model.Nominations.Count</p>
                </div>
                <div class="col-md-4">
                    <p class="mb-1"><strong>فترة الترشيح:</strong> @Model.NominationStart.ToString("dd/MM/yyyy") - @Model.NominationEnd.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Nominations List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">جميع الترشيحات</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Nominations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>المرشح</th>
                                <th>الدائرة</th>
                                <th>المدير</th>
                                <th>تاريخ الترشيح</th>
                                <th>عدد التقييمات</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var nomination in Model.Nominations.OrderBy(n => n.Employee?.DepartmentId).ThenBy(n => n.Employee?.LastName))
                            {
                                <tr class="@(nomination.IsWinner ? "table-success" : "")">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (nomination.IsWinner)
                                            {
                                                <i class="fas fa-crown text-warning me-2"></i>
                                            }
                                            <div>
                                                <div class="fw-bold">@nomination.Employee?.FirstName @nomination.Employee?.LastName</div>
                                                <small class="text-muted">@nomination.Employee?.JobTitle</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@(nomination.Employee?.Department?.Name ?? "")</td>
                                    <td>@nomination.Manager?.FirstName @nomination.Manager?.LastName</td>
                                    <td>@nomination.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge w-100" style="background-color: #007bff; color: white;">@nomination.Evaluations.Count تقييم</span>
                                    </td>
                                    <td>
                                        @if (nomination.IsWinner)
                                        {
                                            <span class="badge bg-success w-100">فائز</span>
                                        }
                                        else if (nomination.Evaluations.Any())
                                        {
                                            <span class="badge bg-info w-100">مقيم</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning w-100">غير مقيم</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", "Nominations", new { id = nomination.NominationId })" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye me-1"></i>عرض
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">لا توجد ترشيحات في هذه الدورة</p>
                </div>
            }
        </div>
    </div>
</div>