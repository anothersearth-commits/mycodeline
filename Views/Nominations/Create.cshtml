@model EOM.Web.Models.Nomination

@{
    ViewData["Title"] = "ترشيح موظف";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Basic RTL adjustments and simple layout (no glassmorphism) */
    body {
        direction: rtl;
    }

    .employee-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
    }

    .employee-card {
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        background: #fff;
        transition: .2s ease-in-out;
        overflow: hidden;
    }

    .employee-info {
        padding: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .employee-info:hover {
        background: #f8f9fa;
    }

    .employee-card.selected {
        border-color: #0d6efd;
    }

    .employee-card.selected .employee-info {
        background: #e7f1ff;
    }

    .employee-avatar {
        flex-shrink: 0;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        overflow: hidden;
        background: #f8f9fa;
        border: 2px solid #dee2e6;
    }

    .employee-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .employee-fallback-icon {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 1.5rem;
    }

    .employee-details {
        flex: 1;
        min-width: 0;
    }

    .employee-name {
        font-weight: 600;
        margin-bottom: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .employee-id {
        font-size: 0.875rem;
        color: #6c757d;
    }

    .nominate-btn {
        width: 100%;
        padding: 0.75rem;
        background: #28a745;
        color: white;
        border: none;
        font-weight: 600;
        transition: background-color 0.2s;
        cursor: pointer;
    }

    .nominate-btn:hover {
        background: #218838;
    }
</style>

<!-- تحديث أنماط بسيطة للتوافق مع Bootstrap -->
<style>
    .quota-info {
        border-radius: .5rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
    }
    .quota-info.success {background:#e9f7ef;border:1px solid #198754;color:#198754;}
    .quota-info.warning {background:#fff3cd;border:1px solid #ffc107;color:#664d03;}
    .quota-info.danger  {background:#f8d7da;border:1px solid #dc3545;color:#842029;}

    .form-container {
        background:#ffffff;
        border:1px solid #dee2e6;
        border-radius:.5rem;
        padding:2rem;
        box-shadow:0 .125rem .25rem rgba(0,0,0,.075);
    }

    .submit-btn {
        background:#0d6efd;
        border:none;
        color:#fff;
        border-radius:.5rem;
        padding:.75rem 1.25rem;
        width:100%;
        margin-top:1.5rem;
    }
    .submit-btn:hover {background:#0b5ed7;}
</style>

<div class="container py-4">
    <h2 class="text-primary text-center mb-4">ترشيح موظف للشهر</h2>

    <!-- باقي محتوى الصفحة داخل نفس الحاوية -->

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Message
        </div>
    }
    else
    {
        var quota = ViewData["DepartmentQuota"] as EOM.Web.Models.DepartmentQuota;
        var existingNominations = (int)(ViewData["ExistingNominations"] ?? 0);
        var canNominate = quota == null || existingNominations < quota?.MaxNominations;

        if (quota != null && quota.MaxNominations > 0)
        {
            <div class="quota-info @(existingNominations >= quota?.MaxNominations ? "danger" : (existingNominations >= quota?.MaxNominations * 0.8 ? "warning" : "success"))">
                <div class="quota-text">
                    حصة الترشيحات للدائرة: @(quota?.MaxNominations - existingNominations) متبقية من @quota?.MaxNominations
                </div>
                <div class="quota-number">
                    @existingNominations/@quota?.MaxNominations
                </div>
            </div>
            
            if (!canNominate)
            {
                <div class="alert alert-danger">
                    لقد استنفدت حصة الترشيحات المسموحة لقسمك (@quota?.MaxNominations ترشيحات)
                </div>
            }
        }

        if (canNominate || (quota != null && quota.MaxNominations <= 0))
        {
            <div class="form-container">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="form-group">
                        <label class="form-label">دورة الجائزة</label>
                        @if ((bool)(ViewBag.HideCycleSelect ?? false))
                        {
                            var selectedItem = ((SelectList)ViewData["CycleId"]).FirstOrDefault();
                            <input type="hidden" asp-for="CycleId" value="@selectedItem?.Value" />
                            <div class="form-control-plaintext mb-2 fw-bold">@selectedItem?.Text</div>
                        }
                        else
                        {
                            <select asp-for="CycleId" class="form-select" asp-items="@((SelectList?)ViewData["CycleId"])">
                                <option value="">اختر دورة الجائزة</option>
                            </select>
                        }
                        <span asp-validation-for="CycleId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">اختر الموظف للترشيح</label>
                        <div class="form-text text-muted mb-2">ملاحظة: الموظفون المرشحون بالفعل في هذه الدورة غير مدرجين في القائمة</div>
                        
                        @if (ViewData["DepartmentEmployees"] != null)
                        {
                            var employees = ViewData["DepartmentEmployees"] as List<EOM.Web.Models.Employee>;
                            
                            @if (employees != null && employees.Any())
                            {
                                <input type="text" id="employeeSearch" class="form-control mb-3" placeholder="ابحث عن موظف بالاسم أو الرقم..." />

                                <div class="employee-grid" id="employeeGrid">
                                    @foreach (var employee in employees)
                                    {
                                        <div class="employee-card" data-employee-id="@employee.EmployeeId">
                                            <div class="employee-info" onclick="selectEmployee(@employee.EmployeeId)">
                                                <div class="employee-avatar">
                                                    @{
                                                        // Try ActiveDirectoryId first, then EmployeeId as fallback
                                                        string adUser = !string.IsNullOrEmpty(employee.ActiveDirectoryId) 
                                                            ? employee.ActiveDirectoryId 
                                                            : employee.EmployeeId.ToString();
                                                    }
                                                    <img src="@Url.Action("WinnerPhoto", "Home", new { adUser = adUser })" 
                                                         alt="@employee.FirstName @employee.LastName"
                                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                    <div class="employee-fallback-icon" style="display: none;">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                </div>
                                                <div class="employee-details">
                                                    <div class="employee-name">@employee.FirstName @employee.LastName</div>
                                                    <div class="employee-id">رقم الموظف: @employee.EmployeeId</div>
                                                </div>
                                                <input type="radio" 
                                                       id="employee_@employee.EmployeeId"
                                                       name="EmployeeId" 
                                                       value="@employee.EmployeeId" 
                                                       required 
                                                       style="display: none;" />
                                            </div>
                                            <button type="submit" class="nominate-btn" id="nominate_@employee.EmployeeId" style="display: none;">
                                                ترشيح @employee.FirstName
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="no-employees">
                                    <i>👥</i>
                                    <p>لا يوجد موظفون في قسمك متاحون للترشيح</p>
                                </div>
                            }
                        }
                        <span asp-validation-for="EmployeeId" class="text-danger"></span>
                    </div>

                    <!-- سيتم رفع المستندات الداعمة لاحقاً أثناء مرحلة التقييم -->
                </form>
            </div>
        }
    }
</div>

<script>
    // Employee selection function
    function selectEmployee(employeeId) {
        // Remove selected class from all cards and hide all nominate buttons
        document.querySelectorAll('.employee-card').forEach(card => {
            card.classList.remove('selected');
            const btn = card.querySelector('.nominate-btn');
            if (btn) btn.style.display = 'none';
        });
        
        // Add selected class to clicked card
        const selectedCard = document.querySelector(`[data-employee-id="${employeeId}"]`);
        if (selectedCard) {
            selectedCard.classList.add('selected');
            
            // Check the radio button
            const radio = selectedCard.querySelector('input[type="radio"]');
            if (radio) {
                radio.checked = true;
            }
            
            // Show the nominate button for this card
            const nominateBtn = selectedCard.querySelector('.nominate-btn');
            if (nominateBtn) {
                nominateBtn.style.display = 'block';
            }
        }
    }

    // live search filter
    const empSearch = document.getElementById('employeeSearch');
    if(empSearch){
        empSearch.addEventListener('input', function(){
            const term = this.value.trim().toLowerCase();
            document.querySelectorAll('#employeeGrid .employee-card').forEach(card=>{
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(term) ? '' : 'none';
            });
        });
    }
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}