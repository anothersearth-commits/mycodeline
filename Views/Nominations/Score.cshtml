@model EOM.Web.Models.Nomination
@using EOM.Web.Models
@using System.Text.Json

@{
    ViewData["Title"] = "تقييم المرشح";
    var idx = 0;
}

<style>
    .total-score-card {
        position: sticky;
        top: 1rem;
        z-index: 1020;
        backdrop-filter: blur(10px);
        background-color: rgba(255, 255, 255, 0.85);
    }
    .score-value {
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--bs-primary);
    }
    .accordion-button {
        font-weight: 600;
    }
    .accordion-button:not(.collapsed) {
        background-color: #e7f1ff;
        color: var(--bs-primary);
    }
    .sub-criterion-item {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #dee2e6;
    }
    .sub-criterion-item:last-child {
        border-bottom: none;
    }
    .grading-scale {
        font-size: 0.8rem;
        color: #6c757d;
        padding-right: 1.5rem;
    }
    .grading-scale strong {
        color: #212529;
    }
</style>

<div class="container py-4">

    <!-- Total Score Card -->
    <div class="card shadow-sm mb-4 total-score-card">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="card-title mb-1">@Model.Employee?.FirstName @Model.Employee?.LastName</h5>
                    <h6 class="card-subtitle text-muted">تقييم الأداء لدورة: @Model.AwardCycle?.AwardType?.Name</h6>
                </div>
                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                    <span class="text-muted">النتيجة الإجمالية</span>
                    <div class="score-value" id="totalScore">0 / 100</div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Score" method="post">
        <div asp-validation-summary="All" class="text-danger alert alert-danger"></div>
        <input type="hidden" name="id" value="@Model.NominationId" />

        <div class="accordion" id="criteriaAccordion">
            @foreach (var criterion in Model.AwardCycle.AwardType.Criteria.OrderBy(c => c.CriterionId))
            {
                <div class="accordion-item" 
                     data-criterion-id="@criterion.CriterionId" 
                     data-criterion-weight="@criterion.WeightPercent">
                    <h2 class="accordion-header" id="heading-@criterion.CriterionId">
                        <button class="accordion-button @(idx == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@criterion.CriterionId" aria-expanded="@(idx == 0 ? "true" : "false")" aria-controls="collapse-@criterion.CriterionId">
                            @criterion.Name
                            <span class="ms-auto badge bg-info text-dark fw-normal">الوزن: @criterion.WeightPercent%</span>
                        </button>
                    </h2>
                    <div id="collapse-@criterion.CriterionId" class="accordion-collapse collapse @(idx == 0 ? "show" : "")" aria-labelledby="heading-@criterion.CriterionId">
                        <div class="accordion-body p-0">
                            <ul class="list-group list-group-flush">
                                @foreach (var sub in criterion.SubCriteria.OrderBy(sc => sc.SubCriteriaCode))
                                {
                                    var scoreEntry = Model.ManagerScores.FirstOrDefault(ms => ms.SubCriteriaId == sub.SubCriteriaId) ?? new ManagerScore { Score = 0 };
                                    <li class="list-group-item sub-criterion-item">
                                        <div class="row align-items-center">
                                            <div class="col-lg-5 mb-2 mb-lg-0">
                                                <label class="form-label fw-bold">@sub.SubCriteriaCode - @sub.Name</label>
                                                <div class="grading-scale">@Html.Raw(GetGradingScaleHtml(sub.GradingScale))</div>
                                            </div>
                                            <div class="col-lg-2 col-md-4 mb-2 mb-md-0">
                                                <label class="form-label d-lg-none">الدرجة</label>
                                                <input type="hidden" name="managerScores[@idx].SubCriteriaId" value="@sub.SubCriteriaId" />
                                                <input type="number" class="form-control text-center score-input" name="managerScores[@idx].Score" min="0" max="@sub.MaxScore" value="@scoreEntry.Score" required placeholder="0-@sub.MaxScore" />
                                            </div>
                                            <div class="col-lg-5 col-md-8">
                                                <label class="form-label d-lg-none">ملاحظات</label>
                                                <textarea class="form-control" name="managerScores[@idx].Note" rows="1" placeholder="ملاحظات (اختياري)">@scoreEntry.Note</textarea>
                                            </div>
                                        </div>
                                    </li>
                                    idx++;
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-grid mt-4">
            <button type="submit" class="btn btn-success btn-lg">حفظ التقييم النهائي</button>
        </div>
    </form>
    <div class="mb-5"></div>
</div>

@functions {
    string GetGradingScaleHtml(string gradingScaleJson)
    {
        if (string.IsNullOrWhiteSpace(gradingScaleJson))
        {
            return "";
        }

        var html = new System.Text.StringBuilder("<ul class='list-unstyled mb-0'>");
        try
        {
            var entries = JsonSerializer.Deserialize<List<Dictionary<string, JsonElement>>>(gradingScaleJson);
            if (entries == null) return "";

            foreach (var entry in entries)
            {
                string value = entry.ContainsKey("score")
                    ? $"<strong>{entry["score"].GetInt32()}</strong>"
                    : $"<strong>{entry["range"].GetString()}</strong>";
                string desc = entry["description"].GetString() ?? "";
                html.Append($"<li>{value}: {desc}</li>");
            }
        }
        catch
        {
            return ""; 
        }
        html.Append("</ul>");
        return html.ToString();
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const scoreInputs = document.querySelectorAll('.score-input');
            const totalScoreEl = document.getElementById('totalScore');

            function calculateTotalScore() {
                let totalWeightedScore = 0;
                const criteriaElements = document.querySelectorAll('.accordion-item');

                criteriaElements.forEach(item => {
                    const weight = parseFloat(item.dataset.criterionWeight) || 0;
                    let criterionTotalScore = 0;
                    let criterionTotalMaxScore = 0;

                    item.querySelectorAll('.score-input').forEach(input => {
                        const score = parseFloat(input.value) || 0;
                        const maxScore = parseFloat(input.getAttribute('max')) || 1;
                        criterionTotalScore += score;
                        criterionTotalMaxScore += maxScore;
                    });
                    
                    if (criterionTotalMaxScore > 0) {
                        const normalizedScore = (criterionTotalScore / criterionTotalMaxScore);
                        totalWeightedScore += normalizedScore * weight;
                    }
                });

                totalScoreEl.textContent = `${totalWeightedScore.toFixed(2)} / 100`;
            }

            scoreInputs.forEach(input => {
                input.addEventListener('input', calculateTotalScore);
            });

            calculateTotalScore();
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
} 