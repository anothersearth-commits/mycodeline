@model IEnumerable<EOM.Web.Models.Nomination>

@{
    ViewData["Title"] = "الترشيحات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* --- Clean, solid, Bootstrap-friendly look (no glassmorphism) --- */
    .page-header {display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;}
    .page-header h1{margin:0;font-size:2rem;font-weight:700;}

    /* Quota card */
    .quota-card{background-color:#f8f9fa;border:1px solid #ced4da;padding:1.5rem;border-radius:0.75rem;margin-bottom:1.5rem;}
    .quota-card.warning{border-color:#ffc107;}
    .quota-card.danger{border-color:#dc3545;}

    /* Container */
    .nominations-container{background-color:#ffffff;border:1px solid #dee2e6;padding:1.5rem;border-radius:0.75rem;}
    /* Cards grid */
    .nominations-row{row-gap:1.5rem;}
    .nomination-card{background-color:#f8f9fa;border:1px solid #dee2e6;border-radius:0.75rem;transition:box-shadow .2s;position:relative;height:100%;}
    .nomination-card:hover{box-shadow:0 0.5rem 1rem rgba(0,0,0,.1);}

    .nomination-status{position:absolute;top:0.75rem;left:0.75rem;font-size:0.75rem;font-weight:600;border-radius:0.5rem;padding:0.25rem 0.6rem;color:#fff;}
    .status-pending{background-color:#ffc107;color:#212529;}
    .status-evaluation{background-color:#0dcaf0;color:#212529;}
    .status-completed{background-color:#198754;}

    .nomination-employee{font-weight:700;margin-bottom:0.5rem;}
    .nomination-award,.nomination-date{font-size:0.9rem;color:#6c757d;margin-bottom:0.25rem;}

    .empty-state{background-color:#f8f9fa;border:1px dashed #ced4da;padding:2rem;border-radius:0.75rem;color:#6c757d;text-align:center;}
    .empty-state i{font-size:3rem;display:block;margin-bottom:1rem;opacity:.6;}
</style>

<div class="page-header">
    <h1>الترشيحات</h1>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Manager"))
        {
            <a href="@Url.Action("Cycles")" class="btn btn-outline-primary">
                <span>📅</span>
                دورات الجوائز
            </a>
        }
        @if (User.IsInRole("Manager") || User.IsInRole("EOM-Admin"))
        {
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <span>➕</span>
                ترشيح جديد
            </a>
        }
    </div>
</div>

@if (User.IsInRole("Manager") && ViewData["DepartmentQuota"] != null)
{
    var quota = ViewData["DepartmentQuota"] as EOM.Web.Models.DepartmentQuota;
    var currentNominations = Model.Count();
    var remainingQuota = quota?.MaxNominations - currentNominations;
    
    <div class="quota-card @(remainingQuota <= 0 ? "danger" : (remainingQuota <= 2 ? "warning" : ""))">
        <div class="quota-info">
            <div class="quota-text">
                حصة الترشيحات للدائرة
            </div>
            <div class="quota-stats">
                <div class="stat-item">
                    <div class="stat-number">@currentNominations</div>
                    <div class="stat-label">مُستخدمة</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">@remainingQuota</div>
                    <div class="stat-label">متبقية</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">@quota?.MaxNominations</div>
                    <div class="stat-label">الإجمالي</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="nominations-container">
    <h2>قائمة الترشيحات</h2>
    
    @if (Model.Any())
    {
        <div class="row nominations-row row-cols-1 row-cols-md-2 row-cols-lg-3">
            @foreach (var nomination in Model)
            {
                <div class="col d-flex">
                <div class="nomination-card p-3 w-100 d-flex flex-column">
                    <div class="nomination-status status-pending">
                        معلق
                    </div>
                    
                    <div class="nomination-employee">
                        @* Employee name will be loaded from navigation property *@
                        موظف رقم @nomination.EmployeeId
                    </div>
                    
                    <div class="nomination-award">
                        @nomination.AwardCycle.AwardType.Name
                    </div>
                    
                    <div class="nomination-date">
                        تاريخ الترشيح: @nomination.CreatedAt.ToString("yyyy/MM/dd")
                    </div>
                    
                    <div class="mt-auto d-flex gap-2">
                        <a href="@Url.Action("Score", new { id = nomination.NominationId })" class="btn btn-primary">
                            📝 تقييم
                        </a>
                        <a href="@Url.Action("Details", new { id = nomination.NominationId })" class="btn btn-secondary">
                            👁️ تفاصيل
                        </a>
                        @if (User.IsInRole("Manager") || User.IsInRole("EOM-Admin"))
                        {
                            <a href="@Url.Action("Delete", new { id = nomination.NominationId })" class="btn btn-danger">
                                🗑️ حذف
                            </a>
                        }
                    </div>
                </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i>📋</i>
            <h3>لا توجد ترشيحات</h3>
            <p>لم يتم إنشاء أي ترشيحات بعد</p>
            @if (User.IsInRole("Manager") || User.IsInRole("EOM-Admin"))
            {
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    ➕ إنشاء ترشيح جديد
                </a>
            }
        </div>
    }
</div>