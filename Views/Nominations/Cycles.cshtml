@model IEnumerable<EOM.Web.Models.AwardCycle>

@{
    ViewData["Title"] = "دورات الجوائز";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .cycles-container {
        padding: 2rem 0;
    }
    
    .cycles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }
    
    .cycle-card {
        background: linear-gradient(145deg, #ffffff, #f8fafc);
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        height: 100%;
        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

    .cycle-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #667eea, #764ba2);
        border-radius: 20px 20px 0 0;
    }

    .cycle-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        border-color: rgba(102, 126, 234, 0.3);
    }

    .card-background-overlay {
        position: absolute;
        top: 0;
        right: 0;
        width: 150px;
        height: 150px;
        background: radial-gradient(circle, rgba(102, 126, 234, 0.05) 0%, transparent 70%);
        border-radius: 50%;
        transform: translate(50%, -50%);
    }
    
    .cycle-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        position: relative;
        z-index: 2;
    }
    
    .cycle-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
        line-height: 1.3;
    }
    
    .cycle-date {
        text-align: center;
        background: linear-gradient(145deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
        backdrop-filter: blur(10px);
        border: 1px solid rgba(102, 126, 234, 0.2);
        border-radius: 15px;
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        min-width: 80px;
    }
    
    .cycle-status {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }
    
    .status-nomination { background: #e3f2fd; color: #1565c0; }
    .status-evaluation { background: #fff3e0; color: #ef6c00; }
    .status-completed { background: #e8f5e8; color: #2e7d32; }
    .status-closed { background: #f5f5f5; color: #616161; }
    
    .nominations-info {
        background: linear-gradient(145deg, #f8fafc, #e2e8f0);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.8);
        flex: 1;
    }
    
    .nominations-count {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .count-number {
        font-size: 1.8rem;
        font-weight: 800;
        color: #667eea;
        line-height: 1;
        margin-bottom: 0.25rem;
    }
    
    .count-label {
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .view-details-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1rem 1.5rem;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }

    .view-details-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s ease;
    }

    .view-details-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        color: white;
    }

    .view-details-btn:hover::before {
        left: 100%;
    }

    .view-details-btn i {
        font-size: 0.9rem;
        transition: transform 0.3s ease;
    }

    .view-details-btn:hover i {
        transform: translateX(-3px);
    }
    
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
    }
    
    .empty-state i {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    @@media (max-width: 768px) {
        .cycle-card {
            margin-bottom: 1.5rem;
            padding: 1.5rem;
        }
        
        .cycle-header {
            flex-direction: column;
            gap: 1rem;
            align-items: center;
            text-align: center;
        }
        
        .cycle-date {
            order: -1;
        }

        .cycles-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }
</style>

<div class="cycles-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary">دورات الجوائز</h1>
        <a href="@Url.Action("Index")" class="btn btn-outline-primary">
            <i class="fas fa-arrow-right"></i> العودة للترشيحات
        </a>
    </div>
    
    @if (Model.Any())
    {
        <div class="cycles-grid">
            @foreach (var cycle in Model)
            {
                <div class="cycle-card" onclick="location.href='@Url.Action("CycleDetails", new { id = cycle.CycleId })'">
                    <div class="card-background-overlay"></div>
                    <div class="cycle-header">
                        <h3 class="cycle-title">@cycle.AwardType?.Name</h3>
                        <div class="cycle-date">@cycle.Month/@cycle.Year</div>
                    </div>
                    
                    <div class="cycle-status @(cycle.Status.ToString().ToLower() switch {
                        "nomination" => "status-nomination",
                        "evaluation" => "status-evaluation", 
                        "completed" => "status-completed",
                        _ => "status-closed"
                    })">
                        @(cycle.Status.ToString() switch {
                            "Nomination" => "مرحلة الترشيح",
                            "Evaluation" => "مرحلة التقييم",
                            "Completed" => "مكتملة",
                            _ => "مغلقة"
                        })
                    </div>
                    
                    <div class="nominations-info">
                        <div class="nominations-count">
                            <div>
                                <div class="count-number">@cycle.Nominations.Count()</div>
                                <div class="count-label">ترشيحاتك</div>
                            </div>
                            @if (cycle.Nominations.Any())
                            {
                                <div class="text-end">
                                    <small class="text-muted">
                                        @cycle.Nominations.Count(n => n.Evaluations != null && n.Evaluations.Any()) مُقيّمة من اللجنة
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <button class="view-details-btn" onclick="event.stopPropagation(); location.href='@Url.Action("CycleDetails", new { id = cycle.CycleId })'">
                        عرض التفاصيل والترشيحات
                        <i class="fas fa-arrow-left ms-2"></i>
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-calendar-alt"></i>
            <h3>لا توجد دورات جوائز</h3>
            <p>لم يتم إنشاء أي دورات جوائز بعد</p>
        </div>
    }
</div>

