@model EOM.Web.Models.Nomination
@{
    ViewData["Title"] = "تفاصيل الترشيح";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<br>

    <!-- Professional Header Section -->
    <div class="bg-gradient-primary text-white rounded-4 p-4 mb-5 shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="position-absolute top-0 end-0 opacity-10">
            <i class="fas fa-trophy" style="font-size: 8rem;"></i>
        </div>
        <div class="row align-items-center position-relative">
            <div class="col-md-8">
                <div class="d-flex align-items-center mb-2">
                    @{
                        var employeeAdUser = Model.Employee?.ActiveDirectoryId;
                        var employeeAvatarId = $"employee-header-avatar-{Model.NominationId}";
                    }
                    <div class="rounded-circle me-3 position-relative" style="width: 60px; height: 60px; overflow: hidden; border: 3px solid rgba(255,255,255,0.3);">
                        <img id="@employeeAvatarId" 
                             data-aduser="@employeeAdUser" 
                             src="/img/default-user.png" 
                             alt="صورة الموظف" 
                             style="width: 100%; height: 100%; object-fit: cover;" />
                        <div class="fallback-icon  bg-opacity-20 d-flex align-items-center justify-content-center" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: none;">
                            <i class="fas fa-award text-white" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                    <div>
                        <h1 class="h3 mb-1 fw-bold">ترشيح : @Model.Employee?.FirstName @Model.Employee?.LastName</h1>
                        <p class="mb-0 opacity-90">
                            <i class="fas fa-medal me-2"></i>
                            @Model.AwardCycle?.AwardType?.Name - @Model.AwardCycle?.Month/@Model.AwardCycle?.Year
                        </p>
                    </div>
                </div>
            </div>
            @if (Model.IsWinner == 1)
            {
                <div class="col-md-4 text-end">
                    <div class="bg-success bg-opacity-20 rounded-pill px-4 py-2 d-inline-block">
                        <i class="fas fa-crown text-warning me-2"></i>
                        <span class="fw-bold">الفائز</span>
                    </div>
                </div>
            }
        </div>
    </div>


    <!-- Modern Score Dashboard -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm position-relative overflow-hidden">
                <div class="position-absolute top-0 start-0 w-100 h-2" style="background: linear-gradient(90deg, #667eea, #764ba2);"></div>
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        @{
                            var adUser = Model.Employee?.ActiveDirectoryId;
                            var avatarId = $"nominee-avatar-{Model.NominationId}";
                        }
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" 
                             style="width: 60px; height: 60px;">
                            <img src="~/img/manager.png" alt="Manager Score" style="width: 40px; height: 40px; object-fit: contain;" />
                        </div>
                        <h6 class="text-muted text-uppercase fw-bold mb-0" style="font-size: 0.75rem; letter-spacing: 1px;">درجة المدير</h6>
                    </div>
                    <div class="mb-3">
                        <span class="display-4 fw-bold" style="color: #667eea;">@GetManagerScore(Model).ToString("F1")</span>
                        <span class="h6 text-muted ms-1">/ 100</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar" style="width: @(GetManagerScore(Model))%; background: linear-gradient(90deg, #667eea, #764ba2);"></div>
                    </div>
                </div>
            </div>
        </div>
        
        @if (User.IsInRole("EOM-Admin"))
        {
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm position-relative overflow-hidden">
                    <div class="position-absolute top-0 start-0 w-100 h-2" style="background: linear-gradient(90deg, #00d4aa, #00b894);"></div>
                    <div class="card-body text-center p-4">
                        <div class="mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" 
                                 style="width: 60px; height: 60px;">
                                <img src="~/img/commiteMemmber.png" alt="Committee Score" style="width: 40px; height: 40px; object-fit: contain;" />
                            </div>
                            <h6 class="text-muted text-uppercase fw-bold mb-0" style="font-size: 0.75rem; letter-spacing: 1px;">درجة اللجنة</h6>
                        </div>
                        <div class="mb-3">
                            <span class="display-4 fw-bold" style="color: #00d4aa;">@GetCommitteeAverage(Model).ToString("F1")</span>
                            <span class="h6 text-muted ms-1">/ 100</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar" style="width: @(GetCommitteeAverage(Model))%; background: linear-gradient(90deg, #00d4aa, #00b894);"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm position-relative overflow-hidden">
                <div class="position-absolute top-0 start-0 w-100 h-2" style="background: linear-gradient(90deg, #fdcb6e, #e17055);"></div>
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" 
                             style="width: 60px; height: 60px;">
                            <img src="~/img/average.png" alt="Average Score" style="width: 40px; height: 40px; object-fit: contain;" />
                        </div>
                        <h6 class="text-muted text-uppercase fw-bold mb-0" style="font-size: 0.75rem; letter-spacing: 1px;">
                            @if (User.IsInRole("EOM-Admin"))
                            {
                                @:المتوسط النهائي
                            }
                            else
                            {
                                @:الدرجة الإجمالية
                            }
                        </h6>
                    </div>
                    <div class="mb-3">
                        <span class="display-4 fw-bold" style="color: #fdcb6e;">
                            @if (User.IsInRole("EOM-Admin"))
                            {
                                @GetFinalAverage(Model).ToString("F1")
                            }
                            else
                            {
                                @GetManagerScore(Model).ToString("F1")
                            }
                        </span>
                        <span class="h6 text-muted ms-1">/ 100</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar" style="width: @(User.IsInRole("EOM-Admin") ? GetFinalAverage(Model) : GetManagerScore(Model))%; background: linear-gradient(90deg, #fdcb6e, #e17055);"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header bg-info text-white">مرفقات المدير</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.SupportingDocPath))
                    {
                        <a href="@Url.Action("Supporting", "Files", new { fileName = Model.SupportingDocPath })" target="_blank" class="btn btn-outline-primary">
                            <i class="fas fa-file-pdf"></i> عرض الملف المرفق
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">لا يوجد ملف مرفق من المدير.</span>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <!-- Manager Evaluation Section (Full Width, Collapsible) -->
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center" 
                     data-bs-toggle="collapse" 
                     data-bs-target="#managerEvalCollapse" 
                     aria-expanded="false" 
                     aria-controls="managerEvalCollapse"
                     style="cursor: pointer; background-color: #007bff; color: white;">
                    <span>
                        <i class="fas fa-chevron-down me-2"></i>
                        تقييم المدير
                    </span>
                    @if (Model.ManagerScores.Any())
                    {
                        <span class="badge bg-dark">الدرجة: @GetManagerScore(Model).ToString("F1") / 100</span>
                    }
                </div>
                <div class="collapse" id="managerEvalCollapse">
                    <div class="card-body">
                        @if (Model.ManagerScores.Any())
                        {
                            <div class="mb-3 p-3 border rounded bg-light">
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <strong>المدير:</strong> @Model.Manager?.FirstName @Model.Manager?.LastName
                                    </div>
                                    <div class="col-md-6">
                                        <strong>تاريخ الترشيح:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                                <table class="table table-sm table-bordered mt-2">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>المعيار الفرعي</th>
                                            <th class="text-center">الدرجة</th>
                                            <th>ملاحظة</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ms in Model.ManagerScores)
                                        {
                                            <tr>
                                                <td>@ms.SubCriteria?.Name</td>
                                                <td class="text-center"><span class="badge" style="background-color: #667eea; color: white;">@ms.Score</span></td>
                                                <td>@ms.Note</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">لا يوجد تقييم مدير بعد.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Committee Evaluations Section (Admin Only) -->
    @if (User.IsInRole("EOM-Admin"))
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center" 
                         data-bs-toggle="collapse" 
                         data-bs-target="#evaluationsCollapse" 
                         aria-expanded="false" 
                         aria-controls="evaluationsCollapse"
                         style="cursor: pointer;">
                        <span>
                            <i class="fas fa-chevron-down me-2"></i>
                            تقييمات اللجنة
                            @if (Model.Evaluations.Any())
                            {
                                <span class="badge bg-dark ms-2">@Model.Evaluations.Count تقييم</span>
                            }
                        </span>
                        @if (Model.Evaluations.Any())
                        {
                            <span class="badge bg-dark">متوسط الدرجة: @GetCommitteeAverage(Model).ToString("F1") / 100</span>
                        }
                    </div>
                    <div class="collapse" id="evaluationsCollapse">
                        <div class="card-body">
                            @if (Model.Evaluations.Any())
                            {
                                @foreach (var eval in Model.Evaluations)
                                {
                                    <div class="mb-4 p-3 border rounded bg-light">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <strong>عضو اللجنة:</strong> @eval.CommitteeMember?.Employee?.FirstName @eval.CommitteeMember?.Employee?.LastName
                                            </div>
                                            <div class="col-md-6">
                                                <strong>تاريخ التقييم:</strong> @eval.CreatedAt.ToString("dd/MM/yyyy")
                                            </div>
                                        </div>
                                        <table class="table table-sm table-bordered mt-2">
                                            <thead class="table-secondary">
                                                <tr>
                                                    <th>المعيار الفرعي</th>
                                                    <th class="text-center">الدرجة</th>
                                                    <th>ملاحظة</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var es in eval.EvaluationScores)
                                                {
                                                    <tr>
                                                        <td>@es.SubCriteria?.Name</td>
                                                        <td class="text-center"><span class="badge" style="background-color: #00d4aa; color: white;">@es.Score</span></td>
                                                        <td>@es.Note</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning">لا توجد تقييمات لجنة بعد.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    // Calculate the manager score for this nomination (sum of all manager scores)
    double GetManagerScore(EOM.Web.Models.Nomination nomination)
    {
        if (nomination.ManagerScores == null || !nomination.ManagerScores.Any())
            return 0;
        
        var validScores = nomination.ManagerScores.Where(ms => ms.Score.HasValue);
        if (!validScores.Any()) return 0;
        
        // Since subcriteria are designed to total 100, just sum them
        return Math.Round(validScores.Sum(ms => (double)ms.Score.Value), 1);
    }

    // Calculate individual committee member score (sum of their evaluation scores)
    double GetCommitteeMemberScore(EOM.Web.Models.Evaluation evaluation)
    {
        if (evaluation.EvaluationScores == null || !evaluation.EvaluationScores.Any())
            return 0;
        
        var validScores = evaluation.EvaluationScores.Where(es => es.Score.HasValue);
        if (!validScores.Any()) return 0;
        
        // Since subcriteria are designed to total 100, just sum them
        return Math.Round(validScores.Sum(es => (double)es.Score.Value), 1);
    }

    // Calculate the average committee score for this nomination
    double GetCommitteeAverage(EOM.Web.Models.Nomination nomination)
    {
        if (nomination.Evaluations == null || !nomination.Evaluations.Any())
            return 0;
        
        var scores = new List<double>();
        foreach (var evaluation in nomination.Evaluations)
        {
            var evalScore = GetCommitteeMemberScore(evaluation);
            if (evalScore > 0) scores.Add(evalScore);
        }
        
        return scores.Any() ? Math.Round(scores.Average(), 1) : 0;
    }

    // Calculate the final average score (average of manager + all committee members)
    double GetFinalAverage(EOM.Web.Models.Nomination nomination)
    {
        var allScores = new List<double>();
        
        // Add manager score if exists
        var managerScore = GetManagerScore(nomination);
        if (managerScore > 0) allScores.Add(managerScore);
        
        // Add each committee member's score
        if (nomination.Evaluations != null)
        {
            foreach (var evaluation in nomination.Evaluations)
            {
                var evalScore = GetCommitteeMemberScore(evaluation);
                if (evalScore > 0) allScores.Add(evalScore);
            }
        }
        
        // Return average: (manager_total + committee1_total + committee2_total + ...) / number_of_evaluators
        return allScores.Any() ? Math.Round(allScores.Average(), 1) : 0;
    }
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function() {
    $('img[data-aduser]').each(function() {
        var $img = $(this);
        var $fallbackIcon = $img.siblings('.fallback-icon');
        var adUser = $img.data('aduser');
        
        if (adUser) {
            var url = '/Home/WinnerPhoto?adUser=' + encodeURIComponent(adUser);
            // Preload image, then set src if successful
            var image = new Image();
            image.onload = function() { 
                $img.attr('src', url);
                $img.show();
                if ($fallbackIcon.length) {
                    $fallbackIcon.hide();
                }
            };
            image.onerror = function() { 
                $img.hide();
                if ($fallbackIcon.length) {
                    $fallbackIcon.show();
                }
            };
            image.src = url;
        } else {
            $img.hide();
            if ($fallbackIcon.length) {
                $fallbackIcon.show();
            }
        }
    });
});
</script> 