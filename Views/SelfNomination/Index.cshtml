@model IEnumerable<EOM.Web.Models.AwardCycle>

@{
    ViewData["Title"] = "الترشيح الذاتي";
    var existingNominations = ViewData["ExistingNominations"] as List<int> ?? new List<int>();
    var userNominations = ViewData["UserNominations"] as Dictionary<int, EOM.Web.Models.Nomination> ?? new Dictionary<int, EOM.Web.Models.Nomination>();
    var teamNominations = ViewData["TeamNominations"] as List<int> ?? new List<int>();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-award text-warning"></i>
                        جوائز المبادرة والابتكار
                    </h3>
                </div>
                <div class="card-body">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            @ViewBag.Message
                        </div>
                    }
                    else if (Model != null && Model.Any())
                    {
                        @if (ViewBag.HasWonEmployeeOfMonth == true && ViewBag.RestrictedAwards != null)
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <strong>تنبيه:</strong> نظراً لفوزك بجائزة موظف الشهر سابقاً، لا يمكنك الترشح للجوائز التالية:
                                <ul class="mb-0 mt-2">
                                    @foreach (var award in (List<string>)ViewBag.RestrictedAwards)
                                    {
                                        <li>@award</li>
                                    }
                                </ul>
                            </div>
                        }
                        
                        @if (ViewBag.RestrictedDueToAward2 != null)
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>ملاحظة:</strong> 
                                @if (ViewBag.IsTeamMemberInAward2 == true)
                                {
                                    <text>أنت عضو في فريق مرشح لإحدى الجوائز، لذا لا يمكنك الترشح لجائزة @ViewBag.RestrictedDueToAward2 في نفس الفترة.</text>
                                }
                                else
                                {
                                    <text>لقد قمت بالترشح لإحدى الجوائز، لذا لا يمكنك الترشح لجائزة @ViewBag.RestrictedDueToAward2 في نفس الفترة.</text>
                                }
                            </div>
                        }
                        
                        @if (ViewBag.RestrictedDueToAward3 != null)
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>ملاحظة:</strong> 
                                @if (ViewBag.IsTeamMemberInAward3 == true)
                                {
                                    <text>أنت عضو في فريق مرشح لإحدى الجوائز، لذا لا يمكنك الترشح لجائزة @ViewBag.RestrictedDueToAward3 في نفس الفترة.</text>
                                }
                                else
                                {
                                    <text>لقد قمت بالترشح لإحدى الجوائز، لذا لا يمكنك الترشح لجائزة @ViewBag.RestrictedDueToAward3 في نفس الفترة.</text>
                                }
                            </div>
                        }
                        
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            يمكنك ترشيح نفسك للجوائز التالية. يمكنك أيضاً إضافة زملاءك كفريق عمل (حد أقصى 5 موظفين إجمالي).
                        </div>

                        <div class="row">
                            @foreach (var cycle in Model)
                            {
                                var isAlreadyNominated = existingNominations.Contains(cycle.CycleId);
                                var isTeamMember = teamNominations.Contains(cycle.CycleId);
                                
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card @(isAlreadyNominated ? "border-success" : "border-primary")">
                                        <div class="card-header @(isAlreadyNominated ? "bg-success text-white" : "bg-primary text-white")">
                                            <h5 class="card-title mb-0">
                                                @cycle.AwardType?.Name
                                                @if (isAlreadyNominated)
                                                {
                                                    <i class="fas fa-check-circle float-left"></i>
                                                }
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text">
                                                <strong>الشهر:</strong> @cycle.Month/@cycle.Year<br>
                                                <strong>الوصف:</strong> @(cycle.AwardType?.Description ?? "لا يوجد وصف")
                                            </p>
                                            
                                            @if (isAlreadyNominated)
                                            {
                                                @if (isTeamMember && userNominations.ContainsKey(cycle.CycleId))
                                                {
                                                    var nom = userNominations[cycle.CycleId];
                                                    if (nom.EmployeeId != int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"))
                                                    {
                                                        <div class="alert alert-info mb-2">
                                                            <i class="fas fa-users"></i>
                                                            أنت عضو في فريق هذا الترشيح
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="alert alert-success mb-2">
                                                            <i class="fas fa-check"></i>
                                                            تم الترشح بنجاح
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="alert alert-success mb-2">
                                                        <i class="fas fa-check"></i>
                                                        تم الترشح بنجاح
                                                    </div>
                                                }
                                                <a href="@Url.Action("Details", new { id = userNominations.ContainsKey(cycle.CycleId) ? userNominations[cycle.CycleId].NominationId : 0 })" 
                                                   class="btn btn-outline-success">
                                                    <i class="fas fa-eye"></i>
                                                    عرض الترشيح
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("Create", new { cycleId = cycle.CycleId })" 
                                                   class="btn btn-primary">
                                                    <i class="fas fa-plus"></i>
                                                    ترشح الآن
                                                </a>
                                            }
                                        </div>
                                        <div class="card-footer text-muted small">
                                            <i class="fas fa-calendar"></i>
                                            فترة الترشيح: @cycle.NominationStart.ToString("dd/MM/yyyy") - @cycle.NominationEnd.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Show success message if exists
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                toastr.success('@TempData["SuccessMessage"]');
            </text>
        }
        
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                toastr.error('@TempData["ErrorMessage"]');
            </text>
        }
    </script>
}