@model IEnumerable<EOM.Web.Models.Nomination>
@{
    ViewData["Title"] = "قاعة الشرف";
    var cycleInfo = ViewBag.CycleInfo as EOM.Web.Models.AwardCycle;
    var totalWinners = ViewBag.TotalWinners as int? ?? 0;
}

<style>
body, .leaderboard-bg {
    background: linear-gradient(120deg, #f8fafc 0%, #e0e7ef 100%) !important;
    min-height: 100vh;
}

.leaderboard-hero {
    text-align: center;
    padding: 3rem 1rem 2rem 1rem;
    margin-bottom: 2rem;
}
.leaderboard-hero .hero-icon {
    font-size: 3.5rem;
    color: #4f8cff;
    margin-bottom: 1rem;
}
.leaderboard-hero .hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #222;
    margin-bottom: 0.5rem;
}
.leaderboard-hero .hero-subtitle {
    font-size: 1.1rem;
    color: #666;
    margin-bottom: 0.5rem;
}

.stats-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
}
.stat-card {
    background: #fff;
    border-radius: 1.2rem;
    box-shadow: 0 4px 24px rgba(80,120,200,0.07);
    padding: 1.5rem 2.2rem;
    min-width: 180px;
    text-align: center;
    flex: 1 1 180px;
    max-width: 260px;
}
.stat-card .stat-icon {
    font-size: 2rem;
    color: #4f8cff;
    margin-bottom: 0.5rem;
}
.stat-card .stat-number {
    font-size: 1.7rem;
    font-weight: 700;
    color: #222;
}
.stat-card .stat-label {
    color: #888;
    font-size: 1rem;
}

.winners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
    margin-bottom: 2.5rem;
}
.winner-card {
    background: #fff;
    border-radius: 1.2rem;
    box-shadow: 0 4px 24px rgba(80,120,200,0.07);
    padding: 2rem 1.2rem 1.5rem 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: box-shadow 0.2s;
}
.winner-card:hover {
    box-shadow: 0 8px 32px rgba(80,120,200,0.13);
}
.winner-avatar {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #e0e7ef;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    color: #4f8cff;
    margin-bottom: 1rem;
}
.winner-badge {
    background: #4f8cff;
    color: #fff;
    border-radius: 1rem;
    padding: 0.25rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.winner-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #222;
    margin-bottom: 0.2rem;
}
.winner-job {
    color: #666;
    font-size: 0.98rem;
    margin-bottom: 0.7rem;
}
.winner-meta {
    color: #888;
    font-size: 0.92rem;
    margin-bottom: 0.7rem;
}
.card-footer {
    background: none;
    border: none;
    padding: 0;
    margin-top: auto;
}
.btn-modern {
    border-radius: 1.2rem;
    font-weight: 600;
    padding: 0.6rem 1.5rem;
    background: #4f8cff;
    color: #fff;
    border: none;
    transition: background 0.2s, box-shadow 0.2s;
    box-shadow: 0 2px 8px rgba(80,120,200,0.08);
}
.btn-modern:hover {
    background: #2563eb;
    color: #fff;
}
.alert.modern-alert {
    border-radius: 1.2rem;
    background: #fff;
    color: #4f8cff;
    border: 1px solid #e0e7ef;
    box-shadow: 0 2px 8px rgba(80,120,200,0.06);
    font-size: 1.05rem;
    margin-bottom: 2rem;
}
@@media (max-width: 600px) {
    .leaderboard-hero .hero-title { font-size: 1.5rem; }
    .stat-card { padding: 1rem 0.5rem; }
    .winners-grid { gap: 1rem; }
    .winner-card { padding: 1.2rem 0.5rem; }
}
</style>

<div class="leaderboard-bg">
    <div class="leaderboard-hero">
        <div class="hero-icon"><i class="fas fa-trophy"></i></div>
        @if (cycleInfo != null)
        {
            <div class="hero-subtitle">
                فائزو <span style="color:#4f8cff;font-weight:600;">@cycleInfo.AwardType.Name</span> - @cycleInfo.Month/@cycleInfo.Year
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Message as string))
    {
        <div class="alert alert-info modern-alert text-center">
            <i class="fas fa-info-circle me-2"></i>
            @ViewBag.Message
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-warning modern-alert text-center">
            <i class="fas fa-exclamation-triangle me-2"></i>
            لا يوجد فائزون في آخر دورة مكتملة
        </div>
    }
    else
    {
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-trophy"></i></div>
                <div class="stat-number">@totalWinners</div>
                <div class="stat-label">إجمالي الفائزين</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-medal"></i></div>
                <div class="stat-number">@cycleInfo?.AwardType.Name</div>
                <div class="stat-label">نوع الجائزة</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-calendar-alt"></i></div>
                <div class="stat-number">@cycleInfo?.Month/@cycleInfo?.Year</div>
                <div class="stat-label">تاريخ الدورة</div>
            </div>
        </div>

        <div class="winners-grid">
            @foreach (var winner in Model)
            {
                <div class="winner-card">
                    <div class="winner-avatar"><i class="fas fa-user"></i></div>
                    <div class="winner-badge"><i class="fas fa-star"></i> فائز</div>
                    <div class="winner-name">@winner.Employee?.FirstName</div>
                    @* <div class="winner-job"><i class="fas fa-briefcase me-1"></i>@winner.Employee?.JobTitle</div> *@
                </div>
                
            }
        </div>

 
    }
</div>