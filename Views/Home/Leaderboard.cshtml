@model IEnumerable<EOM.Web.Models.Nomination>
@{
    ViewData["Title"] = "الفائزون";
    var closedCycles = ViewBag.ClosedCycles as List<EOM.Web.Models.AwardCycle> ?? new List<EOM.Web.Models.AwardCycle>();
    var totalWinners = ViewBag.TotalWinners as int? ?? 0;
    var latestMonth = ViewBag.LatestMonth as int? ?? 0;
    var latestYear = ViewBag.LatestYear as int? ?? 0;
}

<style>
body, .leaderboard-bg {
    background: linear-gradient(120deg, #f8fafc 0%, #e0e7ef 100%) !important;
    min-height: 100vh;
}

.leaderboard-hero {
    text-align: center;
    padding: 3rem 1rem 2rem 1rem;
    margin-bottom: 2rem;
}
.leaderboard-hero .hero-icon {
    font-size: 3.5rem;
    color: #4f8cff;
    margin-bottom: 1rem;
}
.leaderboard-hero .hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #222;
    margin-bottom: 0.5rem;
}
.leaderboard-hero .hero-subtitle {
    font-size: 1.1rem;
    color: #666;
    margin-bottom: 0.5rem;
}

.stats-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
}
.stat-card {
    background: #fff;
    border-radius: 1.2rem;
    box-shadow: 0 4px 24px rgba(80,120,200,0.07);
    padding: 1.5rem 2.2rem;
    min-width: 180px;
    text-align: center;
    flex: 1 1 180px;
    max-width: 260px;
}
.stat-card .stat-icon {
    font-size: 2rem;
    color: #4f8cff;
    margin-bottom: 0.5rem;
}
.stat-card .stat-number {
    font-size: 1.7rem;
    font-weight: 700;
    color: #222;
}
.stat-card .stat-label {
    color: #888;
    font-size: 1rem;
}

.winners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
    margin-bottom: 2.5rem;
}
.winner-card {
    background: #fff;
    border-radius: 1.2rem;
    box-shadow: 0 4px 24px rgba(80,120,200,0.07);
    padding: 2rem 1.2rem 1.5rem 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: box-shadow 0.2s;
}
.winner-card:hover {
    box-shadow: 0 8px 32px rgba(80,120,200,0.13);
}
.winner-avatar {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #e0e7ef;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    color: #4f8cff;
    margin-bottom: 1rem;
}
.winner-badge {
    background: #4f8cff;
    color: #fff;
    border-radius: 1rem;
    padding: 0.25rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.winner-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #222;
    margin-bottom: 0.2rem;
}
.winner-meta {
    color: #888;
    font-size: 0.92rem;
    margin-bottom: 0.7rem;
}
.card-footer {
    background: none;
    border: none;
    padding: 0;
    margin-top: auto;
}
.btn-modern {
    border-radius: 1.2rem;
    font-weight: 600;
    padding: 0.6rem 1.5rem;
    background: #4f8cff;
    color: #fff;
    border: none;
    transition: background 0.2s, box-shadow 0.2s;
    box-shadow: 0 2px 8px rgba(80,120,200,0.08);
}
.btn-modern:hover {
    background: #2563eb;
    color: #fff;
}
.alert.modern-alert {
    border-radius: 1.2rem;
    background: #fff;
    color: #4f8cff;
    border: 1px solid #e0e7ef;
    box-shadow: 0 2px 8px rgba(80,120,200,0.06);
    font-size: 1.05rem;
    margin-bottom: 2rem;
}
.award-type-section {
    background: rgba(255, 255, 255, 0.5);
    border-radius: 1.5rem;
    padding: 2rem 1rem;
    margin-bottom: 2rem;
}

.award-type-section h3 {
    border-bottom: 3px solid #4f8cff;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    display: inline-block;
    width: 100%;
}

.winner-meta .group-members {
    max-height: 50px;
    overflow-y: auto;
    padding: 0.25rem;
    line-height: 1.4;
}

@@media (max-width: 600px) {
    .leaderboard-hero .hero-title { font-size: 1.5rem; }
    .stat-card { padding: 1rem 0.5rem; }
    .winners-grid { gap: 1rem; }
    .winner-card { padding: 1.2rem 0.5rem; }
    .award-type-section { padding: 1rem 0.5rem; }
}
</style>

<div class="leaderboard-bg">
    <div class="leaderboard-hero">
        <div class="hero-icon"><i class="fas fa-trophy"></i></div>
        <div class="hero-title">الفائزون</div>
        <div class="hero-subtitle">
            آخر الفائزين من جميع فئات الجوائز
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Message as string))
    {
        <div class="alert alert-info modern-alert text-center">
            <i class="fas fa-info-circle me-2"></i>
            @ViewBag.Message
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-warning modern-alert text-center">
            <i class="fas fa-exclamation-triangle me-2"></i>
            لا يوجد فائزون في آخر دورة مكتملة
        </div>
    }
    else
    {
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-trophy"></i></div>
                <div class="stat-number">@totalWinners</div>
                <div class="stat-label">إجمالي الفائزين</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-medal"></i></div>
                <div class="stat-number">@closedCycles.Count</div>
                <div class="stat-label">عدد الجوائز</div>
            </div>
        </div>

        @foreach (var awardTypeGroup in Model.GroupBy(n => n.AwardCycle?.AwardType).OrderBy(g => g.Key?.AwardTypeId))
        {
            var cycleInfo = awardTypeGroup.FirstOrDefault()?.AwardCycle;
            <div class="award-type-section mb-5">
                <h3 class="text-center mb-4" style="color: #4f8cff; font-weight: 700;">
                    <i class="fas fa-award me-2"></i>
                    @awardTypeGroup.Key?.Name
                    <span style="font-size: 0.8em; color: #666; font-weight: 500;">
                        (@cycleInfo?.Month/@cycleInfo?.Year)
                    </span>
                </h3>
                <div class="winners-grid">
                    @foreach (var winner in awardTypeGroup)
                    {
                        var adUser = winner.Employee?.ActiveDirectoryId;
                        var winnerId = $"winner-img-{winner.NominationId}";
                        <div class="winner-card">
                            <div class="winner-avatar">
                                <img id="@winnerId" data-aduser="@adUser" src="@Url.Content("~/img/default-user.png")" alt="صورة الفائز" class="rounded-circle" style="width: 70px; height: 70px; object-fit: cover;" />
                            </div>
                            <div class="winner-badge"><i class="fas fa-star"></i> فائز</div>
                            <div class="winner-name">@winner.Employee?.FirstName @winner.Employee?.LastName</div>
                            @if (winner.AwardCycle?.AwardTypeId != 1)
                            {
                                @if (!string.IsNullOrEmpty(winner.Title))
                                {
                                    <div class="winner-initiative" style="font-size: 0.9rem; color: #666; text-align: center; margin-top: 0.5rem;">
                                        <i class="fas fa-lightbulb me-1"></i>
                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@winner.Title">
                                            @winner.Title
                                        </span>
                                    </div>
                                }
                                @if (winner.GroupMembers?.Any() == true)
                                {
                                    <div class="winner-meta text-center mt-2" style="font-size: 0.85rem;">
                                        <i class="fas fa-users me-1"></i>
                                        <span>الفريق:</span>
                                        <div class="group-members" style="font-size: 0.8rem; color: #888; margin-top: 0.3rem;">
                                            @string.Join("، ", winner.GroupMembers.Select(gm => $"{gm.Employee?.FirstName} {gm.Employee?.LastName}"))
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        }

 
    }
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function() {
    $('.winner-avatar img[data-aduser]').each(function() {
        var $img = $(this);
        var adUser = $img.data('aduser');
        if (adUser) {
            var url = '@Url.Action("WinnerPhoto", "Home")' + '?adUser=' + encodeURIComponent(adUser);
            // Preload image, then set src if successful
            var image = new Image();
            image.onload = function() { $img.attr('src', url); };
            image.onerror = function() { $img.attr('src', '@Url.Content("~/img/default-user.png")'); };
            image.src = url;
        }
    });
});
</script>