@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "_Layout";
}

<style>
    /* ===================== LOGIN CARD LAYOUT ===================== */
    .login-wrapper{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1.5rem;}
    .login-card{background:#fff;border-radius:1rem;box-shadow:0 10px 30px rgba(0,0,0,.08);max-width:900px;width:100%;overflow:hidden;display:flex;flex-direction:column;}
    @@media(min-width:768px){.login-card{flex-direction:row;}}

    /* Illustration/branding panel (shows on md+) */
    .branding-section{background:#f8fafc;flex:1 0 50%;display:none;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:2rem;}
    @@media(min-width:768px){.branding-section{display:flex;}}

    .branding-section h2{font-weight:800;color:#2563eb;font-size:1.75rem;margin-bottom:1rem;}
    .branding-section p{color:#64748b;font-size:1rem;max-width:300px;}

    /* Form panel */
    .form-section{flex:1 0 50%;padding:2rem;max-width:400px;margin:auto;}
    .form-section h3{font-weight:700;color:#2563eb;margin-bottom:1.5rem;font-size:1.4rem;}

    /* Input icons */
    .input-container{position:relative;}
    .input-container .form-control{padding-right:3rem;}
    .input-icon{position:absolute;right:1rem;top:50%;transform:translateY(-50%);font-size:1.1rem;color:#64748b;pointer-events:none;}

    /* Validation alert (hide when empty) */
    .form-section .alert:empty{display:none;}
    /* MVC adds 'validation-summary-valid' class when no errors present */
    .validation-summary-valid{display:none;}

    .btn-login{height:48px;font-weight:600;font-size:1rem;}
</style>


<div class="login-wrapper">
    <div class="login-card">
        <!-- Branding / illustration side (desktop only) -->
        <div class="branding-section">
            <img src="~/img/bngLogoTrans.png" alt="شعار محافظة شمال الباطنة" class="logo-image mb-3" />
            <h2>نظام موظف الشهر</h2>
        </div>

        <!-- Form side -->
        <div class="form-section">

            <form method="post" autocomplete="on">
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <!-- Authentication Method Selection -->
                <div class="mb-4">
                    <label class="form-label">طريقة المصادقة</label>
                    <div class="d-flex gap-3 justify-content-center">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="authMethod" id="authMethodAD" value="ActiveDirectory" checked>
                            <label class="form-check-label" for="authMethodAD">
                                🌐 Active Directory
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="authMethod" id="authMethodDB" value="Database">
                            <label class="form-check-label" for="authMethodDB">
                                🛡️ قاعدة البيانات
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="employeeNumber" class="form-label">رقم الموظف</label>
                    <div class="input-container">
                        <input type="text" class="form-control" id="employeeNumber" name="employeeNumber" placeholder="أدخل رقم الموظف" required autocomplete="username">
                        <div class="input-icon">🆔</div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">كلمة المرور</label>
                    <div class="input-container">
                        <input type="password" class="form-control" id="password" name="password" placeholder="أدخل كلمة المرور" required autocomplete="current-password">
                        <div class="input-icon">🔐</div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 btn-login">دخول النظام</button>
            </form>
        </div>
    </div>
</div>