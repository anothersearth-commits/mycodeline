<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item">
        @{
            // Calculate role data directly in the partial view
            bool isManager = User.IsInRole("Manager");
            bool isCommittee = User.IsInRole("EOM-Committee") || User.IsInRole("EOM-Committee-Lead");
            bool isDualRole = isManager && isCommittee;
            
            string? activeRoleParam = Context.Request.Query["activeRole"].FirstOrDefault();
            string? cookieRole = Context.Request.Cookies["UserActiveRole"];
            string currentRole = "Committee"; // Default
            
            if (isDualRole)
            {
                // Priority: URL parameter > Cookie > Default
                currentRole = activeRoleParam ?? cookieRole ?? "Committee";
                
                // If activeRole was provided in URL, update the cookie
                if (!string.IsNullOrEmpty(activeRoleParam))
                {
                    Context.Response.Cookies.Append("UserActiveRole", activeRoleParam, new Microsoft.AspNetCore.Http.CookieOptions
                    {
                        Expires = DateTimeOffset.UtcNow.AddDays(30),
                        HttpOnly = true,
                        SameSite = Microsoft.AspNetCore.Http.SameSiteMode.Lax
                    });
                }
            }
            else if (isManager)
            {
                currentRole = "Manager";
            }
            else if (isCommittee)
            {
                currentRole = "Committee";
            }
            
            string roleLabel = "مستخدم";
            if (User.IsInRole("EOM-Admin")) { 
                roleLabel = "مسؤول النظام"; 
            }
            else if (isDualRole) {
                roleLabel = currentRole == "Manager" ? "مدير" : "عضو لجنة";
            }
            else if (User.IsInRole("Manager")) { 
                roleLabel = "مدير"; 
            }
            else if (User.IsInRole("EOM-Committee") || User.IsInRole("EOM-Committee-Lead")) { 
                roleLabel = "عضو لجنة"; 
            }
        }
        <span class="nav-link">
            مرحباً @User.Identity?.Name!
            <span class="badge bg-info text-dark ms-2">@roleLabel</span>
            @if (isDualRole)
            {
                <button class="btn btn-sm btn-outline-primary ms-2" onclick="showRoleSwitcher()" title="تبديل الدور">
                    ⇄ تبديل
                </button>
            }
        </span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link">تسجيل الخروج</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
    </li>
}
</ul>