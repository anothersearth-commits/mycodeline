<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item">
        @{
            string roleLabel = "مستخدم";
            if (User.IsInRole("EOM-Admin")) { roleLabel = "مسؤول النظام"; }
            else if (User.IsInRole("Manager")) { roleLabel = "مدير"; }
            else if (User.IsInRole("EOM-Committee")) { roleLabel = "عضو لجنة"; }
        }
        <span class="nav-link">
            مرحباً @User.Identity?.Name!
            <span class="badge bg-info text-dark ms-2">@roleLabel</span>
        </span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link">تسجيل الخروج</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
    </li>
}
</ul>