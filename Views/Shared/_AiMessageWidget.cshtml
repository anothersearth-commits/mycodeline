@{
    ViewData["Title"] = "AI Message Widget";
}

<style>
    .ai-message-widget {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    
    .ai-message-widget::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 100%;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: pulse 4s ease-in-out infinite;
    }
    
    @@keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.1); opacity: 0.3; }
    }
    
    .ai-message-content {
        position: relative;
        z-index: 1;
    }
    
    .ai-message-header {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
    }
    
    .ai-message-icon {
        font-size: 2rem;
        margin-left: 0.75rem;
        animation: bounce 2s infinite;
    }
    
    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
    }
    
    .ai-message-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
    }
    
    .ai-message-subtitle {
        font-size: 0.9rem;
        opacity: 0.8;
        margin: 0;
    }
    
    .ai-message-body {
        background: rgba(255,255,255,0.15);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
    }
    
    .ai-message-text {
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 1rem;
        text-align: right;
        direction: rtl;
    }
    
    .ai-advice-text {
        font-size: 1rem;
        line-height: 1.5;
        opacity: 0.9;
        border-top: 1px solid rgba(255,255,255,0.2);
        padding-top: 1rem;
        text-align: right;
        direction: rtl;
    }
    
    .ai-message-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8rem;
        opacity: 0.7;
    }
    
    .ai-message-objective {
        font-size: 0.85rem;
        opacity: 0.8;
    }
    
    .ai-message-loading {
        text-align: center;
        padding: 2rem;
        opacity: 0.7;
    }
    
    .ai-message-loading .spinner {
        display: inline-block;
        width: 40px;
        height: 40px;
        border: 3px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        border-top-color: white;
        animation: spin 1s ease-in-out infinite;
        margin-bottom: 1rem;
    }
    
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    
    .ai-message-error {
        background: rgba(220, 53, 69, 0.2);
        border: 1px solid rgba(220, 53, 69, 0.5);
        color: #fff;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 1rem;
    }
    
    .ai-message-actions {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
        margin-top: 1rem;
    }
    
    .btn-ai-action {
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .btn-ai-action:hover {
        background: rgba(255,255,255,0.3);
        transform: translateY(-1px);
    }
    
    .main-goal-badge {
        background: rgba(255,255,255,0.2);
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.7rem;
        display: inline-block;
        margin-bottom: 0.5rem;
    }
    
    .fade-in {
        animation: fadeIn 0.8s ease-in-out;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="ai-message-widget" id="ai-message-widget">
    <div class="ai-message-content">
        <div class="ai-message-header">
            <div class="ai-message-icon">🤖</div>
            <div>
                <h3 class="ai-message-title">رسالة تحفيزية ذكية</h3>
                <p class="ai-message-subtitle">مُولّدة خصيصاً لأهدافك</p>
            </div>
        </div>
        
        <div id="ai-message-loading" class="ai-message-loading">
            <div class="spinner"></div>
            <p>جاري توليد رسالة تحفيزية مخصصة لك...</p>
        </div>
        
        <div id="ai-message-error" class="ai-message-error" style="display: none;">
            <p>عذراً، حدث خطأ في توليد الرسالة. يرجى المحاولة مرة أخرى.</p>
        </div>
        
        <div id="ai-message-content" style="display: none;">
            <div class="main-goal-badge" id="ai-main-goal"></div>
            
            <div class="ai-message-body">
                <div class="ai-message-text" id="ai-message-text">
                    <!-- AI Message will be inserted here -->
                </div>
                
                <div class="ai-advice-text" id="ai-advice-text">
                    <!-- AI Advice will be inserted here -->
                </div>
            </div>
            
            <div class="ai-message-objective" id="ai-objective-title">
                <!-- Objective title will be inserted here -->
            </div>
            
            <div class="ai-message-footer">
                <span id="ai-message-time"></span>
                <span id="ai-message-status"></span>
            </div>
            
            <div class="ai-message-actions">
                <button class="btn-ai-action" onclick="regenerateAiMessage()">
                    <i class="fas fa-sync-alt"></i> إعادة توليد
                </button>
                <button class="btn-ai-action" onclick="viewAllMessages()">
                    <i class="fas fa-list"></i> عرض جميع الرسائل
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Global variables for AI message management
let currentObjectiveId = null;
let isGenerating = false;

// Initialize AI message widget on page load
$(document).ready(function() {
    loadDailyAiMessage();
});

// Load daily AI message via AJAX
function loadDailyAiMessage() {
    if (isGenerating) return;
    
    isGenerating = true;
    showLoadingState();
    
    // Determine base path for API (works for local and server)
    var basePath = '';
    if (window.location.pathname.toLowerCase().indexOf('/eom/') === 0) {
        basePath = '/EOM';
    }
    $.ajax({
        url: basePath + '/api/AiObjectives/generate-daily-message',
        type: 'POST',
        headers: {
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(data) {
            displayAiMessage(data);
            isGenerating = false;
        },
        error: function(xhr, status, error) {
            console.error('Error loading AI message:', error);
            showErrorState();
            isGenerating = false;
        }
    });
}

// Display AI message in the widget
function displayAiMessage(data) {
    hideLoadingState();
    
    // Set content
    $('#ai-message-text').html(data.message);
    $('#ai-advice-text').html('💡 ' + data.advice);
    $('#ai-objective-title').html('🎯 ' + data.objectiveTitle);
    
    if (data.mainGoal) {
        $('#ai-main-goal').html('📋 ' + data.mainGoal).show();
    } else {
        $('#ai-main-goal').hide();
    }
    
    // Set timestamp
    const timeAgo = getTimeAgo(new Date(data.generated));
    $('#ai-message-time').html('🕐 ' + timeAgo);
    
    // Set status
    const statusText = data.isNew ? 'جديدة' : 'محفوظة';
    $('#ai-message-status').html('✨ ' + statusText);
    
    // Store objective ID for regeneration
    currentObjectiveId = data.objectiveId;
    
    // Show content with animation
    $('#ai-message-content').addClass('fade-in').show();
}

// Regenerate AI message
function regenerateAiMessage() {
    if (!currentObjectiveId || isGenerating) return;
    
    isGenerating = true;
    showLoadingState();
    
    var basePath = '';
    if (window.location.pathname.toLowerCase().indexOf('/eom/') === 0) {
        basePath = '/EOM';
    }
    $.ajax({
        url: `${basePath}/api/AiObjectives/regenerate/${currentObjectiveId}`,
        type: 'POST',
        headers: {
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(data) {
            displayAiMessage(data);
            isGenerating = false;
        },
        error: function(xhr, status, error) {
            console.error('Error regenerating AI message:', error);
            showErrorState();
            isGenerating = false;
        }
    });
}

// View all AI messages (navigate to dedicated page)
function viewAllMessages() {
    window.location.href = '/AiObjectives/MyMessages';
}

// Show loading state
function showLoadingState() {
    $('#ai-message-content').hide();
    $('#ai-message-error').hide();
    $('#ai-message-loading').show();
}

// Hide loading state
function hideLoadingState() {
    $('#ai-message-loading').hide();
}

// Show error state
function showErrorState() {
    $('#ai-message-loading').hide();
    $('#ai-message-content').hide();
    $('#ai-message-error').show();
}

// Get time ago in Arabic
function getTimeAgo(date) {
    const now = new Date();
    const diffInSeconds = Math.floor((now - date) / 1000);
    
    if (diffInSeconds < 60) {
        return 'الآن';
    } else if (diffInSeconds < 3600) {
        const minutes = Math.floor(diffInSeconds / 60);
        return `منذ ${minutes} دقيقة`;
    } else if (diffInSeconds < 86400) {
        const hours = Math.floor(diffInSeconds / 3600);
        return `منذ ${hours} ساعة`;
    } else {
        const days = Math.floor(diffInSeconds / 86400);
        return `منذ ${days} يوم`;
    }
}

// Auto-refresh message every 30 minutes
setInterval(function() {
    if (!isGenerating) {
        loadDailyAiMessage();
    }
}, 30 * 60 * 1000); // 30 minutes
</script>