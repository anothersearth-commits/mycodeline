<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام موظف الشهر</title>
    <link rel="icon" type="image/png" href="~/img/favicon.png" />
    <link rel="shortcut icon" href="~/img/favicon.png" />
    <link rel="apple-touch-icon" href="~/img/favicon.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/arabic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/clean-design.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/designcode-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EOM.Web.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "authenticated" : "login-page")">
@if (User.Identity?.IsAuthenticated == true)
{
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">نظام موظف الشهر</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Leaderboard">
                                <i class="fas fa-trophy me-1"></i>الفائزون
                            </a>
                        </li>
                        @if (User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Nominations" asp-action="Cycles">الترشيحات</a>
                            </li>
                        }
                        @if (User.IsInRole("EOM-Committee"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Evaluations" asp-action="Index">التقييمات</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="DepartmentQuotas" asp-action="Index">حصص الدوائر</a>
                            </li>
                        }
                        @if (User.IsInRole("EOM-Admin") || User.IsInRole("EOM-Committee"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="AwardCycles" asp-action="Index">إدارة الدورات</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer removed as requested -->
}
else
{
    <main role="main">
        @RenderBody()
    </main>
}
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Role Switcher Script -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Helper function to get cookie value
                function getCookie(name) {
                    const value = `; ${document.cookie}`;
                    const parts = value.split(`; ${name}=`);
                    if (parts.length === 2) return parts.pop().split(';').shift();
                    return null;
                }
                
                // Get role data from URL parameters and cookies
                const urlParams = new URLSearchParams(window.location.search);
                const activeRoleParam = urlParams.get('activeRole');
                const cookieRole = getCookie('UserActiveRole');
                
                // Calculate if user has dual roles by checking if switcher button exists
                window.isDualRole = document.querySelector('button[onclick="showRoleSwitcher()"]') !== null;
                
                // Determine current role with priority: URL > Cookie > Default
                window.currentRole = 'Committee'; // Default
                if (window.isDualRole) {
                    window.currentRole = activeRoleParam || cookieRole || 'Committee';
                } else if ('@User.IsInRole("Manager")' === 'True' && !window.isDualRole) {
                    window.currentRole = 'Manager';
                }
            });
            
            function showRoleSwitcher() {
                if (!window.isDualRole) return;
                
                Swal.fire({
                    title: 'تبديل الدور',
                    text: 'اختر الدور الذي تريد التبديل إليه',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: window.currentRole === 'Committee' ? '<i class="fas fa-user-tie me-2"></i>مدير' : '<i class="fas fa-users me-2"></i>عضو لجنة',
                    cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#007bff',
                    cancelButtonColor: '#6c757d',
                    background: '#ffffff',
                    customClass: {
                        popup: 'arabic-swal',
                        title: 'arabic-swal-title',
                        confirmButton: 'arabic-swal-confirm',
                        cancelButton: 'arabic-swal-cancel'
                    },
                    html: `
                        <div class="role-switch-content">
                            <p class="mb-3">الدور الحالي: <span class="badge bg-info">${window.currentRole === 'Committee' ? 'عضو لجنة' : 'مدير'}</span></p>
                            <p class="text-muted">سيتم تحديث الصفحة لإظهار محتوى الدور الجديد</p>
                        </div>
                    `
                }).then((result) => {
                    if (result.isConfirmed) {
                        const newRole = window.currentRole === 'Committee' ? 'Manager' : 'Committee';
                        const currentUrl = new URL(window.location);
                        currentUrl.searchParams.set('activeRole', newRole);
                        
                        // Show loading
                        Swal.fire({
                            title: 'جاري التبديل...',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                        
                        // Redirect to the same page with new role
                        window.location.href = currentUrl.toString();
                    }
                });
            }
        </script>
        
        <style>
            .arabic-swal {
                direction: rtl;
                text-align: right;
            }
            
            .arabic-swal-title {
                font-family: 'Tajawal', Arial, sans-serif;
                font-weight: 600;
            }
            
            .arabic-swal-confirm, .arabic-swal-cancel {
                font-family: 'Tajawal', Arial, sans-serif;
                font-weight: 500;
            }
            
            .role-switch-content {
                text-align: center;
                font-family: 'Tajawal', Arial, sans-serif;
            }
        </style>
    }
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
